{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@darzi/incoming-alert": [
        "modules/incoming-alert/src/index.ts"
      ]
    },
    "types": [
      "nativewind/types"
    ]
  },
  "include": [
    "App.tsx",
    "src",
    "nativewind-env.d.ts",
    "css.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
