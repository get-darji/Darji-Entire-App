{
  "expo": {
    "name": "Darji Delivery",
    "slug": "darji-delivery",
    "owner": "aman-1206",
    "scheme": "darjidelivery",
    "icon": "./app-icon.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.darji.delivery",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.TURN_SCREEN_ON",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "https://darji-entire-app-production.up.railway.app/api",
      "eas": {
        "projectId": "8e90ba3d-8986-4ee9-b045-d0a71892dcb2"
      }
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "android_google_services_file": "./google-services.json"
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Darji Delivery uses your precise phone location for dispatch, route navigation, live rider tracking, and your last known safety location.",
          "locationAlwaysAndWhenInUsePermission": "Darji Delivery shares your live location while you are online so dispatch, customers, and safety operations can track active deliveries.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Darji accesses only the verification photos you choose. Your information is safe with us.",
          "cameraPermission": "Darji uses the camera for secure verification and live order proof. Your information is safe with us."
        }
      ],
      "../../scripts/withFirebaseMessagingManifestFix.js",
      [
        "expo-notifications",
        {
          "icon": "./darji-notification.png",
          "color": "#F6A313",
          "defaultChannel": "darji-incoming-orders-v3",
          "sounds": [
            "./ding.mp3",
            "./requests.mp3"
          ]
        }
      ],
      "./modules/incoming-alert/app.plugin.js",
      "expo-audio",
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.darji.delivery",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8e90ba3d-8986-4ee9-b045-d0a71892dcb2"
    }
  }
}
