{
  "name": "@darzi/delivery-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node ../../scripts/run-expo-with-clean-cache.cjs . start",
    "android": "node ../../scripts/run-expo-with-clean-cache.cjs . run:android",
    "apk": "eas build --platform android --profile production-apk",
    "aab": "eas build --platform android --profile production",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "^57.0.0",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-updates": "~57.0.23",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-hook-form": "^7.68.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.1.17",
    "babel-preset-expo": "~57.0.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@darzi/incoming-alert",
          "@react-native-ml-kit/face-detection",
          "@react-native-ml-kit/text-recognition"
        ]
      }
    }
  }
}
