{
  "name": "darzi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "backend",
    "shared",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:admin": "npm --workspace @darzi/admin-panel run dev",
    "dev:customer-web": "npm --workspace @darzi/customer-web run dev",
    "db:seed": "npm --workspace backend run seed",
    "seed": "npm --workspace backend run seed",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend",
    "android:customer": "npm --workspace @darzi/customer-app run android",
    "android:tailor": "npm --workspace @darzi/tailor-app run android",
    "android:delivery": "npm --workspace @darzi/delivery-app run android"
  },
  "devDependencies": {
    "@expo/config-plugins": "~55.0.11",
    "@expo/ngrok": "^4.1.3",
    "eas-cli": "^20.1.0",
    "expo": "~55.0.28",
    "expo-modules-core": "55.0.25",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "dtrace-provider@0.8.8": true,
    "esbuild@0.28.1": true,
    "mongodb-memory-server@11.2.0": true,
    "protobufjs@7.6.4": true,
    "sharp@0.34.5": true
  }
}
